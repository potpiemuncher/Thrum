<UserControl x:Class="DS4WinWPF.DS4Forms.ControllerOverviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DS4WinWPF.DS4Forms.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="940">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="OverviewCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="OverviewEyebrowStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
        </Style>

        <Style x:Key="OverviewValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="OverviewSpeakerPanelStyle" TargetType="Grid">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsEnabled" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedControllerSupportsAudio}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverviewQuickSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="28" VerticalAlignment="Center">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="{DynamicResource AccentColor}"
                                                        CornerRadius="3" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Knob" Background="{DynamicResource ForegroundColor}"
                                                        BorderBrush="{DynamicResource AccentColor}"
                                                        BorderThickness="2" CornerRadius="9" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Knob" Property="BorderThickness" Value="3" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="{DynamicResource BorderColor}"
                                                        CornerRadius="3" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Native PS5 mode card (design handoff, N1). Badge and border follow
            the view model's Kind tokens so the six states share one template.
        -->
        <Style x:Key="OverviewKindBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource MutedForegroundColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Danger">
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerColor}" />
                    <Setter Property="Background" Value="{DynamicResource DangerBackgroundColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Warning">
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningColor}" />
                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Success">
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessColor}" />
                    <Setter Property="Background" Value="{DynamicResource SuccessBackgroundColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverviewKindBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Danger">
                    <Setter Property="Foreground" Value="{DynamicResource DangerColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Success">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            The mode switch is a Button drawn as a 36x20 switch, not a
            CheckBox: its position mirrors the profile (IsOn) and never flips
            on its own. Space and Enter both invoke it; the window decides
            whether that turns the mode on, opens setup, or asks before
            turning it off.
        -->
        <Style x:Key="OverviewSwitchButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Background" Value="{DynamicResource BorderColor}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Track" Width="36" Height="20" CornerRadius="10"
                                    Background="{TemplateBinding Background}">
                                <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3"
                                         HorizontalAlignment="Left"
                                         Fill="{DynamicResource ForegroundColor}" />
                            </Border>
                            <Border x:Name="FocusRing" CornerRadius="12" Margin="-3"
                                    BorderBrush="{DynamicResource FocusRingColor}" BorderThickness="2"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentColor}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverviewOutlineAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style x:Key="OverviewToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ToggleTrack" Width="36" Height="20"
                                    HorizontalAlignment="Left" CornerRadius="10"
                                    Background="{DynamicResource BorderColor}">
                                <Ellipse x:Name="ToggleKnob" Width="14" Height="14" Margin="3"
                                         HorizontalAlignment="Left"
                                         Fill="{DynamicResource ForegroundColor}" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource AccentColor}" />
                                <Setter TargetName="ToggleKnob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470" Padding="30">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource OverviewCardStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelectedController}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
                <Border Width="54" Height="54" CornerRadius="27"
                        Background="{DynamicResource RaisedBackgroundColor}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                               Foreground="{DynamicResource AccentColor}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="No controller selected" Margin="0,16,0,5"
                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Connect a controller, then choose it from the device cards in the upper-left corner."
                           Foreground="{DynamicResource MutedForegroundColor}" TextAlignment="Center"
                           TextWrapping="Wrap" />
                <!--
                    Shown disabled rather than hidden. With no controller the
                    quick-action bar is not rendered at all, so nothing on this
                    page tells a first-time user the input tester exists; they
                    would have to connect a pad to discover the feature that
                    tells them whether their pad works.
                -->
                <Button Content="_Test inputs" Margin="0,18,0,0"
                        HorizontalAlignment="Center" IsEnabled="False"
                        Style="{StaticResource BridgeSecondaryButtonStyle}"
                        ToolTip="Connect a controller to test its buttons, sticks, triggers, gyro and touchpad."
                        Click="TestInputsBtn_Click" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,8,6">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelectedController}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource OverviewCardStyle}" Padding="20" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="152" Height="92" CornerRadius="5" Margin="0,0,20,0"
                                Background="{DynamicResource RaisedBackgroundColor}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <Image Source="{Binding SelectedController.ControllerImageSource}"
                                   Stretch="Uniform" Margin="7"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="SELECTED CONTROLLER" Style="{StaticResource OverviewEyebrowStyle}" />
                            <TextBlock Text="{Binding SelectedController.ControllerDisplayName}"
                                       Margin="0,5,0,3" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundColor}" />
                            <TextBlock Text="{Binding SelectedController.IdText}"
                                       Foreground="{DynamicResource MutedForegroundColor}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Background="{DynamicResource RaisedBackgroundColor}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                        CornerRadius="3" Padding="8,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Profile  " Foreground="{DynamicResource MutedForegroundColor}" />
                                        <TextBlock Text="{Binding CurrentProfileName}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentColor}"
                                                   MaxWidth="190" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CurrentProfileName}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource RaisedBackgroundColor}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                        CornerRadius="3" Padding="8,4">
                                    <TextBlock Text="{Binding SelectedControllerConnection}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock Text="BATTERY" Style="{StaticResource OverviewEyebrowStyle}"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding SelectedControllerBattery}" Margin="0,5,0,0"
                                        FontSize="20" FontWeight="SemiBold"
                                        Foreground="{DynamicResource SuccessColor}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding SelectedControllerChargingState}"
                                       Margin="0,3,0,0" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <WrapPanel Grid.Row="1" Margin="-6,0,-6,8">
                    <Border Style="{StaticResource OverviewCardStyle}" Width="218" MinHeight="112" Margin="6">
                        <StackPanel>
                            <TextBlock Text="CONNECTION" Style="{StaticResource OverviewEyebrowStyle}" />
                            <TextBlock Text="{Binding SelectedControllerConnection}" Margin="0,11,0,3"
                                       Style="{StaticResource OverviewValueStyle}" />
                            <TextBlock Text="{Binding SelectedControllerLatency, StringFormat=Input latency {0}}"
                                        Foreground="{DynamicResource MutedForegroundColor}" />
                            <TextBlock Text="{Binding SelectedControllerAccessStatus}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OverviewCardStyle}" Width="218" MinHeight="112" Margin="6">
                        <StackPanel>
                            <TextBlock Text="ACTIVE PROFILE" Style="{StaticResource OverviewEyebrowStyle}" />
                            <ComboBox x:Name="ActiveProfileComboBox"
                                      ItemsSource="{Binding SelectedController.ProfileListCol}"
                                      DisplayMemberPath="Name"
                                      SelectedIndex="{Binding SelectedController.SelectedIndex, Mode=TwoWay}"
                                      Style="{StaticResource BridgeProfileComboBoxStyle}"
                                      HorizontalAlignment="Left" Margin="0,8,0,5"
                                      SelectionChanged="ActiveProfileComboBox_SelectionChanged" />
                             <TextBlock Text="Settings below save to this profile"
                                        TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OverviewCardStyle}" Width="218" MinHeight="112" Margin="6">
                        <StackPanel>
                            <TextBlock Text="EMULATED DEVICE" Style="{StaticResource OverviewEyebrowStyle}" />
                            <TextBlock Margin="0,11,0,3" Style="{StaticResource OverviewValueStyle}"
                                       Text="{Binding SelectedOutputControllerName}" />
                             <TextBlock Text="Applied through the active profile"
                                        TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OverviewCardStyle}" Width="218" MinHeight="112" Margin="6">
                        <StackPanel>
                            <TextBlock Text="CONTROLLER STATUS" Style="{StaticResource OverviewEyebrowStyle}" />
                            <TextBlock Text="{Binding SelectedControllerStartupTitle}"
                                       Margin="0,11,0,3">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource OverviewValueStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedControllerIsReady}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedControllerNeedsAttention}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFB020" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                             <TextBlock Text="{Binding SelectedControllerStartupDetail}"
                                        TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!--
                    Native PS5 mode. Shown for a DualSense or DualSense Edge
                    only; other pads keep the Emulated device combo below.
                    Six states, one template: see NativePs5ModeViewModel.
                -->
                <Border x:Name="NativePs5Card" Grid.Row="2" Margin="0,0,0,14"
                        AutomationProperties.Name="Native PS5 mode"
                        Visibility="{Binding ShowNativePs5Mode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource OverviewCardStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NativePs5.CardBorderKind}" Value="Success">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessColor}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NativePs5.CardBorderKind}" Value="Warning">
                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningColor}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid DataContext="{Binding NativePs5}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Native PS5 mode" FontSize="17" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource OverviewKindBadgeStyle}" Margin="10,0,0,0">
                                <TextBlock Text="{Binding BadgeText}" Style="{StaticResource OverviewKindBadgeTextStyle}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal"
                                    VerticalAlignment="Top" Margin="24,2,0,0">
                            <TextBlock Text="{Binding SwitchLabel}" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                            <Button x:Name="NativePs5SwitchButton"
                                    Style="{StaticResource OverviewSwitchButtonStyle}"
                                    AutomationProperties.Name="{Binding SwitchAccessibleName}"
                                    ToolTip="{Binding SwitchToolTip}"
                                    Click="NativePs5SwitchButton_Click" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                <Run Text="Games see " Foreground="{DynamicResource MutedForegroundColor}" />
                                <Run Text="{Binding GamesSeeText, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding GamesSeeSuffix, Mode=OneWay}" Foreground="{DynamicResource MutedForegroundColor}" />
                            </TextBlock>
                            <TextBlock Text="{Binding PrimaryLine}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding SecondaryLine}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Foreground="{DynamicResource MutedForegroundColor}"
                                       Visibility="{Binding HasSecondaryLine, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <Border Background="{DynamicResource WarningBackgroundColor}"
                                    BorderBrush="{DynamicResource WarningColor}" BorderThickness="1"
                                    CornerRadius="4" Padding="10,8" Margin="0,0,0,6"
                                    Visibility="{Binding ShowHidHideWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="14" Height="14" CornerRadius="7" Margin="0,2,8,0"
                                            BorderBrush="{DynamicResource WarningColor}" BorderThickness="1"
                                            VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap">
                                        <Run Text="{Binding HidHideWarningText, Mode=OneWay}" />
                                        <Hyperlink x:Name="HidHideClientLink" Click="HidHideClientLink_Click"
                                                   Foreground="{DynamicResource AccentTextColor}"
                                                   AutomationProperties.Name="Open the HidHide client"
                                                   ToolTip="Opens the HidHide configuration client, or its download page when HidHide is not installed.">Open the HidHide client</Hyperlink><Run Text=". " />
                                        <Run Text="{x:Static vm:NativePs5ModeViewModel.HidHideWorksWithoutNote}" />
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <StackPanel Margin="0,0,0,6"
                                        Visibility="{Binding ShowAudioEndpointsLine, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{x:Static vm:NativePs5ModeViewModel.AudioEndpointsUnverifiedLine}"
                                           TextWrapping="Wrap" Foreground="{DynamicResource WarningColor}" />
                                <TextBlock Text="{Binding AudioEndpointsRiskText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{DynamicResource WarningColor}" />
                            </StackPanel>

                            <Button x:Name="NativePs5SetupButton" Content="{Binding SetupButtonText}"
                                    HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Style="{StaticResource OverviewOutlineAccentButtonStyle}"
                                    Visibility="{Binding ShowSetupButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="Opens setup at the step that is still missing."
                                    Click="NativePs5SetupButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,18">
                            <TextBlock Text="Quick profile controls" FontSize="18" FontWeight="SemiBold" />
                             <TextBlock Text="Changes are saved to the selected controller's active profile and applied automatically."
                                        Margin="0,3,0,0" TextWrapping="Wrap"
                                        Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding SelectedController.FeedbackControlLabel}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding HapticStrengthPercent, StringFormat={}{0}%}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" />
                             <Slider Grid.Row="1" Grid.ColumnSpan="2" Margin="0,9,0,0"
                                     Style="{StaticResource OverviewQuickSliderStyle}"
                                    Minimum="0" Maximum="100" TickFrequency="1"
                                    Value="{Binding HapticStrengthPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=220}" />
                        </Grid>

                        <!-- A DualSense gets the Native PS5 mode card instead of this combo. -->
                        <StackPanel Grid.Row="2" Margin="0,19,0,0"
                                    Visibility="{Binding ShowEmulatedDeviceChoice, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Emulated device" FontWeight="SemiBold" />
                             <ComboBox ItemsSource="{Binding OutputControllerChoices}"
                                      DisplayMemberPath="Name" SelectedValuePath="Type"
                                      SelectedValue="{Binding SelectedOutputController, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Style="{StaticResource BridgeProfileComboBoxStyle}"
                                       HorizontalAlignment="Left" Margin="0,8,0,0" />
                            <TextBlock Text="Changing the output device briefly reloads this controller's profile."
                                       Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" FontSize="11" />
                        </StackPanel>

                        <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
                                <TextBlock Text="{Binding SelectedController.ControllerAudioHeader}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedController.ControllerAudioDescription}"
                                           Margin="0,3,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundColor}" />
                            </StackPanel>

                            <Grid Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="2"
                                  Style="{StaticResource OverviewSpeakerPanelStyle}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                 <CheckBox Grid.ColumnSpan="2" Content="Stream audio to controller"
                                           Style="{StaticResource OverviewToggleStyle}"
                                          IsChecked="{Binding SpeakerOutputEnabled, Mode=TwoWay}"
                                          ToolTip="Streams the selected audio to the controller speaker and to a headset connected to its AUX port."
                                          Margin="0,0,0,12" />
                                <CheckBox Grid.Row="1" Grid.ColumnSpan="2"
                                          Content="Headset only (mute controller speaker)"
                                          Style="{StaticResource OverviewToggleStyle}"
                                          IsChecked="{Binding HeadsetOnlyAudio, Mode=TwoWay}"
                                          IsEnabled="{Binding SpeakerOutputEnabled}"
                                          ToolTip="Mutes the built-in speaker while continuing the same stream through a headset connected to the controller's AUX port."
                                          Margin="0,0,0,12" />
                                <TextBlock Grid.Row="2" Text="Speaker level" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{Binding SpeakerVolumePercent, StringFormat={}{0}%}"
                                           Foreground="{DynamicResource AccentColor}" />
                                 <Slider Grid.Row="3" Grid.ColumnSpan="2" Margin="0,7,0,14"
                                         Style="{StaticResource OverviewQuickSliderStyle}"
                                        Minimum="0" Maximum="100" TickFrequency="1"
                                        Value="{Binding SpeakerVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=220}" />
                            </Grid>

                            <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                                 <CheckBox Content="{Binding SelectedController.MicrophoneToggleLabel}"
                                           Style="{StaticResource OverviewToggleStyle}"
                                          IsChecked="{Binding MicrophoneInputEnabled, Mode=TwoWay}"
                                          IsEnabled="{Binding CanChangeMicrophoneInput}"
                                          ToolTip="{Binding MicrophoneAvailabilityText}"
                                          Margin="0,0,0,9" />
                                <TextBlock Text="{Binding SelectedController.MicrophoneDescription}"
                                           Margin="0,0,0,9" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundColor}" />
                                <TextBlock Margin="0,0,0,9" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundColor}"
                                           Text="{Binding MicrophoneAvailabilityText}"
                                           Visibility="{Binding ShowMicrophoneAvailabilityMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Grid IsEnabled="{Binding MicrophoneLevelControlsEnabled}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Microphone level" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding MicrophoneVolumePercent, StringFormat={}{0}%}"
                                               Foreground="{DynamicResource AccentColor}" />
                                     <Slider Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0"
                                             Style="{StaticResource OverviewQuickSliderStyle}"
                                            Minimum="0" Maximum="100" TickFrequency="1"
                                            Value="{Binding MicrophoneVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=220}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource OverviewCardStyle}">
                    <StackPanel>
                        <StackPanel>
                            <TextBlock Text="Quick actions" FontSize="18" FontWeight="SemiBold" />
                             <TextBlock Text="Jump into the full editor or manage the selected physical controller."
                                        Margin="0,3,0,0" TextWrapping="Wrap"
                                        Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>
                        <WrapPanel Margin="0,15,0,0">
                            <Button Content="_Test inputs" Margin="0,0,8,0"
                                    Style="{StaticResource BridgePrimaryButtonStyle}"
                                    Click="TestInputsBtn_Click" />
                            <Button Content="Edit active profile" Margin="0,0,8,0"
                                    Style="{StaticResource BridgeSecondaryButtonStyle}"
                                    Click="EditProfileBtn_Click" />
                            <Button Content="Controller details" Margin="0,0,8,0"
                                    Style="{StaticResource BridgeSecondaryButtonStyle}"
                                    Click="ControllerDetailsBtn_Click" />
                            <Button x:Name="IdentifyControllerButton" Content="Identify" Margin="0,0,8,0"
                                    Style="{StaticResource BridgeSecondaryButtonStyle}"
                                    Visibility="{Binding SelectedController.SupportsLightbar, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="Briefly flashes the physical controller lightbar, then restores its current lightbar state"
                                    Click="IdentifyControllerBtn_Click" />
                            <Button Content="Lightbar controls" Margin="0,0,8,0"
                                    Style="{StaticResource BridgeSecondaryButtonStyle}"
                                    ToolTip="Use profile lightbar controls or choose a temporary custom color"
                                    Click="LightbarBtn_Click" />
                            <Button Content="Disconnect"
                                    Style="{StaticResource BridgeSecondaryButtonStyle}"
                                    IsEnabled="{Binding SelectedControllerIsWireless}"
                                    Click="DisconnectBtn_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
