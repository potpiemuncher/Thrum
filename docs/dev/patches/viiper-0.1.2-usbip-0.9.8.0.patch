From c4ff272008d54325542262f621ebc917766b147e Mon Sep 17 00:00:00 2001
From: potpiemuncher <patrick.wall90@gmail.com>
Date: Wed, 9 Sep 2026 21:18:08 -0500
Subject: [PATCH 2/2] Match MSVC base-subobject padding in plugin_hardware
 (1120 bytes)

MSVC pads the imported_device_location base to its full sizeof (1096),
so serial starts at offset 1100 and sizeof(plugin_hardware) is 1120,
not 1116. The 0.9.8.0 driver returned STATUS_BUFFER_TOO_SMALL for the
shorter request; with explicit padding the attach succeeds and the
device appears on usbip port 1.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 internal/server/api/autoattach_windows.go      | 7 ++++++-
 internal/server/api/autoattach_windows_test.go | 2 +-
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/internal/server/api/autoattach_windows.go b/internal/server/api/autoattach_windows.go
index 10565ff..9788a00 100644
--- a/internal/server/api/autoattach_windows.go
+++ b/internal/server/api/autoattach_windows.go
@@ -59,15 +59,20 @@ const (
 // PLUGIN_HARDWARE structure from usbip-win2
 // Layout matches usbip-win2 0.9.8.0 include/usbip/vhci.h:
 // struct plugin_hardware : base, imported_device_location { char serial[16]; bool wsk_events; }
-// The driver rejects the request unless Size == sizeof(plugin_hardware) (1116 bytes).
+// MSVC pads each base subobject to its own sizeof: imported_device_location is
+// 1093 bytes of members padded to 1096, so serial starts at offset 1100 and the
+// whole struct is 1120 bytes. The driver requires the input length to be
+// exactly sizeof(plugin_hardware) and Size to equal it.
 type attachIOCTL struct {
 	Size       uint32
 	PortOutput int32
 	BusID      [32]byte
 	Service    [niMaxServ]byte
 	Host       [niMaxHost]byte
+	_          [3]byte // tail padding of imported_device_location
 	Serial     [16]byte
 	WskEvents  bool
+	_          [3]byte // tail padding of plugin_hardware
 }
 
 const (
diff --git a/internal/server/api/autoattach_windows_test.go b/internal/server/api/autoattach_windows_test.go
index 27aa6c7..6efb835 100644
--- a/internal/server/api/autoattach_windows_test.go
+++ b/internal/server/api/autoattach_windows_test.go
@@ -10,7 +10,7 @@ import (
 )
 
 func TestUsbipAttachABISizes(t *testing.T) {
-	require.Equal(t, uintptr(1116), unsafe.Sizeof(attachIOCTL{}),
+	require.Equal(t, uintptr(1120), unsafe.Sizeof(attachIOCTL{}),
 		"usbip-win2 0.9.8.0 plugin_hardware ABI changed")
 }
 
-- 
2.53.0.windows.2

