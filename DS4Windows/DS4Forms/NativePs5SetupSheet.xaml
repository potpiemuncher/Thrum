<UserControl x:Class="DS4WinWPF.DS4Forms.NativePs5SetupSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DS4WinWPF.DS4Forms.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="560"
             d:DataContext="{d:DesignInstance Type=vm:NativePs5SetupViewModel}"
             Width="560" HorizontalAlignment="Right"
             Focusable="True" FocusManager.IsFocusScope="True"
             KeyboardNavigation.TabNavigation="Cycle"
             AutomationProperties.Name="Set up Native PS5 mode"
             PreviewKeyDown="Sheet_PreviewKeyDown">
    <!--
        Native PS5 mode setup (design handoff: setup sheet, four steps).
        A slide-over hosted by MainWindow behind a scrim. Every button here
        runs an existing handler through the window; the sheet itself owns
        only step position and text. Consent checkboxes bind OneWay on
        purpose: their Checked/Unchecked handlers are the only writers, and
        neither is ever pre-checked.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="SheetBodyTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SheetMutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SheetBodyTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
        </Style>

        <Style x:Key="SheetStepTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SheetBodyTextStyle}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SheetNoteBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource RaisedBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style x:Key="SheetPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="MinHeight" Value="34" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                    <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundColor}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SheetSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="34" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundColor}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Pill badge whose colour follows a Kind token: Muted, Danger, Warning, Success. -->
        <Style x:Key="SheetKindBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource MutedForegroundColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SheetKindBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SheetWarningBadgeStyle" TargetType="Border" BasedOn="{StaticResource SheetKindBadgeStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource WarningColor}" />
            <Setter Property="Background" Value="{DynamicResource WarningBackgroundColor}" />
        </Style>

        <Style x:Key="SheetWarningBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SheetKindBadgeTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
        </Style>

        <Style x:Key="SheetSuccessBadgeStyle" TargetType="Border" BasedOn="{StaticResource SheetKindBadgeStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessColor}" />
            <Setter Property="Background" Value="{DynamicResource SuccessBackgroundColor}" />
        </Style>

        <Style x:Key="SheetSuccessBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SheetKindBadgeTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
        </Style>

        <!-- Driver-status badge: same BadgeKind tokens the Settings card uses. -->
        <Style x:Key="SheetDriverBadgeStyle" TargetType="Border" BasedOn="{StaticResource SheetKindBadgeStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Unverified">
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerColor}" />
                    <Setter Property="Background" Value="{DynamicResource DangerBackgroundColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Experimental">
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningColor}" />
                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Approved">
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessColor}" />
                    <Setter Property="Background" Value="{DynamicResource SuccessBackgroundColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SheetDriverBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SheetKindBadgeTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Unverified">
                    <Setter Property="Foreground" Value="{DynamicResource DangerColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Experimental">
                    <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Approved">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Rail ring: done = success fill + tick, current = accent ring, idle = border ring; step 4 dashed = optional. -->
        <Style x:Key="SheetRailRingStyle" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RingKind}" Value="Current">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RingKind}" Value="Done">
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessColor}" />
                    <Setter Property="Background" Value="{DynamicResource SuccessColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SheetRailGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RingKind}" Value="Current">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RingKind}" Value="Done">
                    <Setter Property="Foreground" Value="{DynamicResource CardBackgroundColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SheetRailTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SheetConsentCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource CheckBoxStyle}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundColor}"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Margin="22,18,22,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundColor}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SheetMutedTextStyle}" />
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" Content="&#x2715;" Width="32" Height="32"
                        Style="{StaticResource SheetSecondaryButtonStyle}" Padding="0"
                        AutomationProperties.Name="Close" ToolTip="Close (Esc). Steps already completed stay saved."
                        Click="CloseButton_Click" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- rail: not focusable, read-only progress -->
                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0"
                        Padding="22,8,10,0">
                    <ItemsControl ItemsSource="{Binding RailSteps}" IsTabStop="False"
                                  Focusable="False" AutomationProperties.Name="Steps">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SheetRailRingStyle}">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource SheetRailGlyphStyle}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SheetRailTitleStyle}" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedForegroundColor}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- body -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="22,8,22,0"
                              AutomationProperties.Name="{Binding StepAccessibleName}">
                    <Grid>
                        <!-- step 1: install -->
                        <StackPanel x:Name="Step1Panel"
                                    Visibility="{Binding IsStep1, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding Step1Title}" Style="{StaticResource SheetStepTitleStyle}" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" DataContext="{Binding DriverStatus}">
                                <Border Style="{StaticResource SheetDriverBadgeStyle}">
                                    <TextBlock Text="{Binding BadgeText}" Style="{StaticResource SheetDriverBadgeTextStyle}" />
                                </Border>
                                <TextBlock Text="{Binding CheckedAtText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource SheetMutedTextStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding DriverStatus.Headline}" Style="{StaticResource SheetBodyTextStyle}" Margin="0,0,0,12" />

                            <StackPanel DataContext="{Binding DriverStatus}" Margin="0,0,0,6"
                                        Visibility="{Binding HasReasons, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="What could not be confirmed" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundColor}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Reasons}" Margin="16,0,0,8" IsTabStop="False"
                                              AutomationProperties.Name="What could not be confirmed">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource BridgeCardListItemStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel DataContext="{Binding DriverStatus}" Margin="0,0,0,6"
                                        Visibility="{Binding HasIdentities, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Detected package identity" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundColor}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Identities}" IsTabStop="False"
                                              AutomationProperties.Name="Detected package identity">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Component}" Foreground="{DynamicResource ForegroundColor}"
                                                           FontSize="12" Margin="0,0,0,2" />
                                                <ItemsControl ItemsSource="{Binding Fields}" Margin="12,0,0,0" IsTabStop="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Display}" Style="{StaticResource BridgeCardListItemStyle}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border Style="{StaticResource SheetNoteBoxStyle}" Margin="0,0,0,12"
                                    Visibility="{Binding HasInstallMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding InstallMessage}" Style="{StaticResource SheetBodyTextStyle}" />
                            </Border>

                            <Border Style="{StaticResource SheetNoteBoxStyle}" Margin="0,0,0,12"
                                    Visibility="{Binding ShowBackendHint, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding BackendHint}" Style="{StaticResource SheetBodyTextStyle}" />
                            </Border>

                            <Border Style="{StaticResource SheetNoteBoxStyle}" Margin="0,0,0,12">
                                <TextBlock Text="{Binding NotApprovedNote}" Style="{StaticResource SheetMutedTextStyle}" />
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="InstallButton" Content="{Binding InstallLabel}"
                                        Style="{StaticResource SheetPrimaryButtonStyle}"
                                        IsEnabled="{Binding CanInstall}"
                                        ToolTip="Runs the bundled VIIPER setup with administrator rights. It installs the exact usbip-win2 package this build lists."
                                        Click="InstallButton_Click" />
                                <Button x:Name="RecheckButton" Content="Recheck" Margin="8,0,0,0"
                                        Style="{StaticResource SheetSecondaryButtonStyle}"
                                        IsEnabled="{Binding CanInstall}"
                                        ToolTip="Reads the installed driver packages and pings the backend again. Nothing is installed or changed."
                                        Click="RecheckButton_Click" />
                            </StackPanel>
                            <TextBlock Text="{Binding InstallLogText}" FontSize="11"
                                       Style="{StaticResource SheetMutedTextStyle}" Margin="0,0,0,12" />
                        </StackPanel>

                        <!-- step 2: read and accept -->
                        <StackPanel x:Name="Step2Panel"
                                    Visibility="{Binding IsStep2, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding Step2Title}" Style="{StaticResource SheetStepTitleStyle}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Step2Intro}" Style="{StaticResource SheetMutedTextStyle}" Margin="0,0,0,12" />
                            <ScrollViewer x:Name="AcknowledgementScroller" MaxHeight="260" MinHeight="120"
                                          VerticalScrollBarVisibility="Auto" Focusable="True" IsTabStop="True"
                                          Background="{DynamicResource RaisedBackgroundColor}"
                                          BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                          Padding="12,10" Margin="0,0,0,12"
                                          AutomationProperties.Name="Experimental kernel driver disclosure"
                                          ToolTip="Keyboard stop: scroll with the arrow keys, Page Up and Page Down.">
                                <TextBlock Text="{Binding AcknowledgementBody}" Style="{StaticResource SheetMutedTextStyle}"
                                           LineHeight="18" />
                            </ScrollViewer>
                            <CheckBox x:Name="AcknowledgeCheckBox"
                                      IsChecked="{Binding Acknowledged, Mode=OneWay}"
                                      Checked="AcknowledgeCheckBox_Changed"
                                      Unchecked="AcknowledgeCheckBox_Changed"
                                      Style="{StaticResource SheetConsentCheckBoxStyle}"
                                      AutomationProperties.Name="{Binding AcknowledgementLabel}">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="{Binding AcknowledgementLabel}" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource ForegroundColor}" />
                                    <TextBlock Text="{Binding AcknowledgementNote}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AcknowledgementNoteKind}" Value="Success">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>

                        <!-- step 3: turn on -->
                        <StackPanel x:Name="Step3Panel"
                                    Visibility="{Binding IsStep3, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Visibility="{Binding NotOnYet, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding Step3Title}" Style="{StaticResource SheetStepTitleStyle}" Margin="0,0,0,12" />

                                <Border Style="{StaticResource SheetNoteBoxStyle}" Margin="0,0,0,12"
                                        BorderBrush="{DynamicResource WarningColor}"
                                        Background="{DynamicResource WarningBackgroundColor}"
                                        Visibility="{Binding WaitingForDualSense, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding WaitingForDualSenseText}" Style="{StaticResource SheetBodyTextStyle}" />
                                </Border>

                                <Border Style="{StaticResource SheetNoteBoxStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SheetBodyTextStyle}">
                                            <Run Text="{Binding PadSummary, Mode=OneWay}" />
                                            <Run Text="{Binding ProfileName, Mode=OneWay}" FontWeight="SemiBold"
                                                 Foreground="{DynamicResource AccentTextColor}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Step3AppliesTo}" FontSize="11" Style="{StaticResource SheetMutedTextStyle}" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Step3Bullets}" Margin="0,0,0,12" IsTabStop="False"
                                              AutomationProperties.Name="What turning on changes">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource SheetBodyTextStyle}" Margin="12,0,0,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Visibility="{Binding Inputs.IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Step3OnTitle}" Style="{StaticResource SheetStepTitleStyle}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SheetSuccessBadgeStyle}" Margin="10,0,0,0">
                                        <TextBlock Text="On" Style="{StaticResource SheetSuccessBadgeTextStyle}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource SheetBodyTextStyle}" Margin="0,0,0,10">
                                    <Run Text="Games see " Foreground="{DynamicResource MutedForegroundColor}" />
                                    <Run Text="{Binding GamesSeeOn, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Text="{Binding Step3HapticsNote}" Style="{StaticResource SheetMutedTextStyle}" Margin="0,0,0,12" />
                            </StackPanel>
                        </StackPanel>

                        <!-- step 4: haptics over the virtual pad (optional) -->
                        <StackPanel x:Name="Step4Panel"
                                    Visibility="{Binding IsStep4, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Step4Title}" Style="{StaticResource SheetStepTitleStyle}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource SheetWarningBadgeStyle}" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Step4Badge}" Style="{StaticResource SheetWarningBadgeTextStyle}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Step4Intro}" Style="{StaticResource SheetBodyTextStyle}" Margin="0,0,0,12" />

                            <CheckBox x:Name="AudioConsentCheckBox"
                                      IsChecked="{Binding AudioEndpointsAllowed, Mode=OneWay}"
                                      Checked="AudioConsentCheckBox_Changed"
                                      Unchecked="AudioConsentCheckBox_Changed"
                                      Style="{StaticResource SheetConsentCheckBoxStyle}" Margin="0,0,0,12"
                                      AutomationProperties.Name="{Binding AudioConsentLabel}">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="{Binding AudioConsentLabel}" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource ForegroundColor}" />
                                    <TextBlock Text="{Binding AudioConsentNote}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Foreground="{DynamicResource MutedForegroundColor}" />
                                </StackPanel>
                            </CheckBox>

                            <TextBlock Text="{Binding AudioClassSummary}" Style="{StaticResource SheetBodyTextStyle}"
                                       Foreground="{DynamicResource WarningColor}" Margin="0,0,0,12" />

                            <Border Style="{StaticResource SheetNoteBoxStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{x:Static vm:NativePs5SetupViewModel.AudioDefaultTakeoverWarningTitle}"
                                               FontWeight="SemiBold" Style="{StaticResource SheetBodyTextStyle}" Margin="0,0,0,4" />
                                    <TextBlock Text="{x:Static vm:NativePs5SetupViewModel.AudioDefaultTakeoverWarningText}"
                                               Style="{StaticResource SheetMutedTextStyle}" Margin="0,0,0,8" />
                                    <Button Content="Restore my previous default device" IsEnabled="False"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource SheetSecondaryButtonStyle}"
                                            ToolTip="{x:Static vm:NativePs5SetupViewModel.RestoreDefaultDeviceUnavailableReason}"
                                            ToolTipService.ShowOnDisabled="True" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- footer -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="22,14,22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Content="Back" Style="{StaticResource SheetSecondaryButtonStyle}"
                            Visibility="{Binding CanBack, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,0,8,0" Click="BackButton_Click" />
                    <TextBlock Grid.Column="1" Text="{Binding FooterHint}" Style="{StaticResource SheetMutedTextStyle}"
                               VerticalAlignment="Center" />
                    <Button x:Name="Step4LinkButton" Grid.Column="2" Content="{Binding Step4LinkLabel}"
                            Style="{StaticResource SheetSecondaryButtonStyle}" Margin="8,0,0,0"
                            Visibility="{Binding ShowStep4Link, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="Step4LinkButton_Click" />
                    <Button x:Name="PrimaryButton" Grid.Column="3" Content="{Binding PrimaryLabel}"
                            Style="{StaticResource SheetPrimaryButtonStyle}" Margin="8,0,0,0"
                            IsEnabled="{Binding PrimaryEnabled}"
                            ToolTip="{Binding PrimaryToolTip}"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTipService.IsEnabled="{Binding HasPrimaryToolTip}"
                            Click="PrimaryButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
