<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <targets async="true">
    <!-- Will override fileName and archive name in bootstrap code.
         fileName attribute needed here by NLog -->
    <target name="logfile" xsi:type="File" fileName="thrum_log.txt" layout="${longdate}|${level:uppercase=true}|${message}"
            maxArchiveFiles="7" archiveNumbering="DateAndSequence" archiveDateFormat="yyyyMMdd" archiveOldFileOnStartup="True"
            archiveAboveSize="10485760" />
    <!-- archiveAboveSize: one long session used to grow a single log file
         without limit. Each file is now capped at 10 MB, so the log folder
         holds at most about 80 MB (the current file plus 7 archives). -->
    <!--<target name="logconsole" xsi:type="Console" />-->
  </targets>

  <rules>
    <!--<logger name="*" minlevel="Info" writeTo="logconsole" />-->
    <logger name="*" minlevel="Info" writeTo="logfile" />
  </rules>
</nlog>